# ──────────────────────────────────────────────────────────────────────────────
# VayuSense — backend (Cloud Functions / Cloud Run) environment
# Copy to .env and fill in. When keys are absent the API automatically serves
# deterministic DEMO MODE data, so the whole product works without credentials.
# ──────────────────────────────────────────────────────────────────────────────

# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: route Gemini through Vertex AI instead of AI Studio
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
USE_VERTEX_AI=false

# Google Maps Platform — Air Quality API, Maps JS, Places, Routes
GOOGLE_MAPS_API_KEY=

# Google Cloud Natural Language API (community report sentiment)
GOOGLE_NL_API_KEY=

# Google Cloud Translation API (multilingual health advisories)
GOOGLE_TRANSLATE_API_KEY=

# reCAPTCHA Enterprise — https://cloud.google.com/recaptcha-enterprise
RECAPTCHA_ENTERPRISE_SITE_KEY=
RECAPTCHA_ENTERPRISE_PROJECT_ID=
# Dedicated API key with the reCAPTCHA Enterprise API enabled (fail-closed if absent)
RECAPTCHA_ENTERPRISE_API_KEY=

# Firebase Admin (Cloud Functions uses ADC automatically on GCP;
# for local standalone mode point to a service account file)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=vayusense-demo

# App Check enforcement (disabled in demo mode)
APP_CHECK_ENABLED=false

# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
