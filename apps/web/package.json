{
  "name": "@vayusense/web",
  "version": "1.0.0",
  "private": true,
  "description": "VayuSense web client — React 18 + Vite + Tailwind 3.4 PWA with Firebase, Google Maps and GA4.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
