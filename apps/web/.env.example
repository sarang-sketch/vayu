# ──────────────────────────────────────────────────────────────────────────────
# VayuSense web client — copy to .env.local
# All keys are OPTIONAL: missing keys switch the corresponding feature to
# deterministic demo mode (the app never crashes without credentials).
# ──────────────────────────────────────────────────────────────────────────────

# API origin (empty = same-origin /api via Vite proxy or Firebase Hosting rewrite)
VITE_API_BASE_URL=

# Firebase (Authentication, Firestore, Analytics, Remote Config, FCM, App Check)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Maps Platform (Maps JS + Air Quality API + Places)
VITE_GOOGLE_MAPS_API_KEY=

# reCAPTCHA Enterprise site key (App Check + civic report protection)
VITE_RECAPTCHA_SITE_KEY=

# Firebase Cloud Messaging web push certificate key pair
VITE_FCM_VAPID_KEY=

# Google Analytics 4 measurement id (G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=
