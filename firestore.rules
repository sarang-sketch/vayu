rules_version = '2';

// VayuSense Firestore security model
// ─────────────────────────────────────────────────────────────────────────────
// • Profiles & households are private to their owner (Google Sign-In uid).
// • Routines and impact logs are owner-scoped; reads require auth.
// • Community reports are publicly readable (civic data), writable only by
//   authenticated users, and immutable after creation (moderation via Admin SDK).
// • AQI cache and advisories are server-managed (Admin SDK bypasses rules).
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validReport() {
      let d = request.resource.data;
      return d.keys().hasAll(['location', 'category', 'description', 'severity', 'authorUid', 'createdAt'])
        && d.description is string
        && d.description.size() >= 10
        && d.description.size() <= 500
        && d.severity is int
        && d.severity >= 1 && d.severity <= 5
        && d.category in ['traffic', 'burning', 'construction', 'industry', 'other']
        && d.authorUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'persona', 'city', 'locale', 'sensitivities', 'createdAt', 'fcmTokens']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt']);
      allow delete: if isOwner(uid);
    }

    match /households/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /routines/{routineId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /impactLogs/{logId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.co2eKg is number
        && request.resource.data.co2eKg >= 0;
      allow update, delete: if false; // append-only ledger
    }

    match /communityReports/{reportId} {
      allow read: if true;
      allow create: if signedIn() && validReport();
      allow update, delete: if false;
    }

    match /aqiCache/{cellId} {
      allow read: if true;
      allow write: if false; // populated by Cloud Functions only
    }

    match /advisories/{advisoryId} {
      allow read: if true;
      allow write: if false; // official advisories, Admin SDK only
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
